# ============================================================
# Frontend Production Environment Configuration (.env.production)
# ============================================================

NODE_ENV=production
PORT=3000

# Backend internal URL for server-side Next.js rewrites
BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# Public API URL for client-side fetches (Leave empty if using same domain with Nginx reverse proxy)
NEXT_PUBLIC_API_URL=

